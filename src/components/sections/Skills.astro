---
import { buttonVariants } from "../ui/button";
import Icon from "../ui/Icon.astro";
import { Separator } from "../ui/separator";
import SectionHeader from "./SectionHeader.astro";
import Reveal from "../react/Reveal";
import { copy } from "../../data/content";
import { skills } from "../../data/skills";
import { certificates } from "../../data/certificates";
import { brand } from "../../lib/brands";

const marks = skills.flatMap((skill) => {
	const icon = brand(skill.slug);
	return icon ? [{ ...skill, icon }] : [];
});

const verifyClass = buttonVariants({ variant: "outline" });
---

<section id="skills" class="section-pad">
	<div class="shell">
		<Reveal client:visible>
			<SectionHeader
				id="skills-heading"
				label={copy.skills.label}
				heading={copy.skills.heading}
			/>

			<ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
				{
					marks.map(({ label, icon }) => (
						<li class="skill group flex flex-col items-center gap-3 text-center">
							<svg
								viewBox="0 0 24 24"
								fill="currentColor"
								aria-hidden="true"
								class="size-7 sm:size-8"
								style={`--brand: #${icon.hex}`}
							>
								<path d={icon.path} />
							</svg>
							<span class="text-label uppercase tracking-label text-ink-2">
								{label}
							</span>
						</li>
					))
				}
			</ul>

			<div class="mt-20 sm:mt-24">
				<Separator className="mb-12 sm:mb-16" />

				<p class="text-label uppercase tracking-label text-ink-2">
					{copy.credentials.label}
				</p>
				<h3
					id="credentials-heading"
					class="mt-4 font-serif text-h2 leading-[1.12] font-light text-ink scroll-mt-24"
				>
					{copy.credentials.heading}
				</h3>

				<ul class="mt-10">
					{
						certificates.map((certificate, index) => (
							<>
								{index > 0 && <Separator />}
								<li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5">
									<div class="min-w-0">
										<p class="text-body text-ink">{certificate.title}</p>
										<p class="mt-1 text-label uppercase tracking-label text-ink-2">
											{certificate.issuer}
											{certificate.year && ` · ${certificate.year}`}
										</p>
									</div>
									<a
										href={certificate.verifyUrl}
										target="_blank"
										rel="noopener noreferrer"
										class={verifyClass}
									>
										{copy.credentials.verifyLabel}
										<Icon name="arrow-up-right" dataIcon="inline-end" />
									</a>
								</li>
							</>
						))
					}
				</ul>
			</div>
		</Reveal>
	</div>
</section>

<style>
	/* Greyscale at rest, brand colour on hover or tap. Colour is never
	   load-bearing here, so it is safe to live in :hover/:active only. */
	.skill svg {
		color: var(--palette-text-2);
		transition:
			color 500ms ease-out,
			transform 500ms ease-out;
	}

	.skill:hover svg,
	.skill:active svg {
		color: var(--brand);
		transform: translateY(-2px);
	}
</style>