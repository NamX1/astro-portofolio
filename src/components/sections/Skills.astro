---
import { getImage } from "astro:assets";

import SectionHeading from "../react/SectionHeading";
import Reveal from "../react/Reveal";
import CertificateGrid from "../react/CertificateGrid";
import { copy } from "../../data/content";
import { skills } from "../../data/skills";
import { certificates } from "../../data/certificates";

/**
 * Optimise the certificate images here rather than inside the island.
 *
 * astro:assets <Image /> is an Astro component and cannot render inside a
 * React island. getImage() is the documented equivalent for that case and
 * returns the same optimised output, which we pass down as plain props.
 *
 * `densities` produces the srcset (getImage has no `sizes` option).
 */
function toSrcSet(
	srcSet: { values: { url: string; descriptor?: string }[] } | undefined,
): string | undefined {
	if (!srcSet?.values?.length) return undefined;
	return srcSet.values
		.map((value) =>
			value.descriptor ? `${value.url} ${value.descriptor}` : value.url,
		)
		.join(", ");
}

const items = await Promise.all(
	certificates.map(async (certificate) => {
		const thumb = await getImage({
			src: certificate.image,
			width: 800,
			format: "webp",
			densities: [1, 1.5],
		});
		const large = await getImage({
			src: certificate.image,
			width: certificate.image.width,
			format: "webp",
		});

		return {
			title: certificate.title,
			issuer: certificate.issuer,
			verifyUrl: certificate.verifyUrl,
			alt: certificate.alt,
			issued: certificate.issued,
			summary: certificate.summary,
			thumb: {
				src: thumb.src,
				width: Number(thumb.attributes.width),
				height: Number(thumb.attributes.height),
				srcSet: toSrcSet(thumb.srcSet),
			},
			large: {
				src: large.src,
				width: Number(large.attributes.width),
				height: Number(large.attributes.height),
				srcSet: toSrcSet(large.srcSet),
			},
			labels: { verifyAction: copy.credentials.verifyAction },
		};
	}),
);

const stackLine = skills.map((skill) => skill.label).join(" · ");
---

<section id="skills" class="section-pad">
	<div class="shell">
		<SectionHeading
			client:visible
			label={copy.skills.label}
			lines={copy.skills.lines}
			headingId="skills-heading"
			className="mb-10 sm:mb-12"
		>
			{/*
				One quiet line instead of a logo grid. Six framework logos were the
				most interchangeable object on the page and the only chromatic
				event on a monochrome site - and they duplicated the per-project
				`tech` chips, which live in src/data/projects.ts.
			*/}
			<p class="rv text-body text-ink-2" translate="no">{stackLine}</p>
		</SectionHeading>

		<Reveal client:visible>
			<CertificateGrid client:visible items={items} />
		</Reveal>
	</div>
</section>