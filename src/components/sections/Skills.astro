---
import { getImage } from "astro:assets";

import SkillMark from "../ui/SkillMark.astro";
import SectionHeading from "../react/SectionHeading";
import Reveal from "../react/Reveal";
import BandReveal from "../react/BandReveal";
import CertificateGrid from "../react/CertificateGrid";
import { copy } from "../../data/content";
import { marqueeSkills, skillGroups } from "../../data/skills";
import { certificates } from "../../data/certificates";

/**
 * Optimise the certificate images here rather than inside the island.
 *
 * astro:assets <Image /> is an Astro component and cannot render inside a
 * React island. getImage() is the documented equivalent for that case and
 * returns the same optimised output, which we pass down as plain props.
 *
 * Two sizes: a thumbnail for the grid, a full-size one for the dialog.
 * `densities` produces the srcset (getImage has no `sizes` option).
 */
function toSrcSet(
	srcSet: { values: { url: string; descriptor?: string }[] } | undefined,
): string | undefined {
	if (!srcSet?.values?.length) return undefined;
	return srcSet.values
		.map((value) =>
			value.descriptor ? `${value.url} ${value.descriptor}` : value.url,
		)
		.join(", ");
}

const items = await Promise.all(
	certificates.map(async (certificate) => {
		const thumb = await getImage({
			src: certificate.image,
			width: 800,
			format: "webp",
			densities: [1, 1.5],
		});
		const large = await getImage({
			src: certificate.image,
			width: certificate.image.width,
			format: "webp",
		});

		return {
			title: certificate.title,
			issuer: certificate.issuer,
			verifyUrl: certificate.verifyUrl,
			alt: certificate.alt,
			issued: certificate.issued,
			summary: certificate.summary,
			thumb: {
				src: thumb.src,
				width: Number(thumb.attributes.width),
				height: Number(thumb.attributes.height),
				srcSet: toSrcSet(thumb.srcSet),
			},
			large: {
				src: large.src,
				width: Number(large.attributes.width),
				height: Number(large.attributes.height),
				srcSet: toSrcSet(large.srcSet),
			},
			labels: { verifyAction: copy.credentials.verifyAction },
		};
	}),
);

/**
 * The marquee repeats its list three times and translates by exactly one
 * third, so the seam lands on an identical copy of the start. Two copies only
 * works while one set is wider than the viewport, which stops being true on a
 * wide monitor.
 */
const marqueeRepeats = 3;
---

<section id="skills" class="section-pad">
	<div class="shell">
		<SectionHeading
			client:visible
			label={copy.skills.label}
			lines={copy.skills.lines}
			headingId="skills-heading"
			className="mb-10 sm:mb-12"
		/>

		{/*
			Decorative motion, so it is CSS only - no island, no JS shipped.
			The repeated copies are hidden from assistive tech; the first copy is
			the real list.

			The container is focusable so the scroll can be stopped with a
			keyboard. Nothing inside the marquee is itself focusable, so
			:focus-within would otherwise never fire and a keyboard user would
			have no way to pause it - which WCAG 2.2.2 asks for, since the
			animation starts on its own and runs for 42 seconds. It pauses on
			hover too, but hover is not a mechanism a keyboard user can reach.
		*/}
		<div
			class="marquee"
			tabindex="0"
			role="group"
			aria-label="Skills in use, scrolling"
		>
			<ul class="marquee-track">
				{
					Array.from({ length: marqueeRepeats }).flatMap((_, repeat) =>
						marqueeSkills.map((skill) => (
							<li
								class="marquee-item skill"
								aria-hidden={repeat > 0 ? "true" : undefined}
							>
								<SkillMark skill={skill} class="size-6 sm:size-7" />
								<span class="text-label uppercase tracking-label text-ink-2" translate="no">
									{skill.label}
								</span>
							</li>
						)),
					)
				}
			</ul>
		</div>

		{
			skillGroups.length > 0 && (
				<div class="mt-16 sm:mt-20">
					<BandReveal client:visible>
						{skillGroups.map((group) => (
							<div class="band">
								<span class="band-rule band-rule-top" aria-hidden="true" />

								<div class="band-row">
									<h3 class="band-label text-label uppercase tracking-label text-ink-2">
										{group.label}
									</h3>
									<ul class="band-items">
										{group.skills.map((skill) => (
											<li class="band-item skill">
												<SkillMark skill={skill} class="size-5" />
												<span class="text-body text-ink-2" translate="no">
													{skill.label}
												</span>
											</li>
										))}
									</ul>
								</div>

								<span class="band-rule band-rule-bottom" aria-hidden="true" />
							</div>
						))}
					</BandReveal>
				</div>
			)
		}

		<div class="mt-20 sm:mt-24">
			<Reveal client:visible>
				<CertificateGrid client:visible items={items} />
			</Reveal>
		</div>
	</div>
</section>

<style>
	/* Logo marquee.

	   Every item carries the same trailing margin, so one set is exactly one
	   third of the track and the -33.333% landing is pixel-identical to the
	   start. No will-change: the track is promoted by the compositor anyway,
	   and holding a permanent hint on a strip this wide costs memory. */
	.marquee {
		overflow: hidden;
		/* Fade the edges so items enter and leave instead of being guillotined
		   by the clip. */
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 8%,
			#000 92%,
			transparent
		);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee-scroll 42s linear infinite;
	}

	.marquee-item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-right: 2.5rem;
		white-space: nowrap;
		/* Headroom for the hover lift. The icon is the tallest thing in the
		   row, so without this its top edge sits exactly on the marquee's
		   clip edge and `overflow: hidden` cuts 2px off it on hover. The
		   padding is symmetrical, so the icon and the label stay aligned with
		   each other. */
		padding-block: 4px;
	}

	/* Hover and focus are the same affordance: the track stops moving. Focus
	   matters as much as hover here, because a keyboard user cannot hover. */
	.marquee:hover .marquee-track,
	.marquee:focus-within .marquee-track {
		animation-play-state: paused;
	}

	/* Stated locally as well as globally. The marquee is the one place on the
	   page where focus does something, so the ring must not be lost to a
	   future outline-none. */
	.marquee:focus-visible {
		outline: 2px solid var(--palette-text-2);
		outline-offset: 3px;
	}

	@keyframes marquee-scroll {
		to {
			transform: translateX(-33.3333%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		/* Stop the scroll and show the list once, wrapped. Motion is not
		   load-bearing: the seven skills stay readable either way. */
		.marquee {
			mask-image: none;
		}

		.marquee-track {
			animation: none;
			width: auto;
			flex-wrap: wrap;
			justify-content: flex-start;
			gap: 0.75rem 2rem;
		}

		/* Hide the two duplicate copies. */
		.marquee-track > :nth-child(n + 8) {
			display: none;
		}

		.marquee-item {
			margin-right: 0;
		}
	}
</style>
