---
import HeroEntrance from "../react/HeroEntrance";
import { copy } from "../../data/content";
import { profile } from "../../data/profile";
---

<section
	id="top"
	class="relative flex min-h-svh items-center justify-center pt-24 pb-20 sm:pt-28"
>
	<HeroEntrance
		client:load
		name={profile.name}
		tagline={profile.tagline}
		contactLabel={copy.hero.contactLabel}
		projectsLabel={copy.hero.projectsLabel}
		email={profile.email}
	/>
</section>