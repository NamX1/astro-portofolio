---
import SectionHeading from "../react/SectionHeading";
import ProjectGrid from "../react/ProjectGrid";
import { copy } from "../../data/content";
import { projects, projectStatusLabels } from "../../data/projects";

const items = projects.map((project) => ({
	slug: project.slug,
	title: project.title,
	statusLabel: projectStatusLabels[project.status],
	summary: project.summary,
	tech: project.tech,
}));
---

<section id="projects" class="section-pad">
	<div class="shell">
		<SectionHeading
			client:visible
			label={copy.projects.label}
			lines={copy.projects.lines}
			headingId="projects-heading"
			className="mb-12 sm:mb-16"
		/>

		<ProjectGrid client:visible items={items} />
	</div>
</section>