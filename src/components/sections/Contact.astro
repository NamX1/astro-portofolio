---
import SectionHeading from "../react/SectionHeading";
import Reveal from "../react/Reveal";
import ContactPanel from "../react/ContactPanel";
import { copy } from "../../data/content";
import { hasEmail, hasWhatsApp } from "../../data/profile";
import { contactChannels } from "../../data/contact";

// A channel you meant to publish but have not filled in yet should fail the
// conversation, not vanish quietly.
if (!hasEmail) {
	console.warn(
		"[content] profile.email is empty - the Email channel is hidden. Set it in src/data/profile.ts.",
	);
}
if (!hasWhatsApp) {
	console.warn(
		"[content] profile.whatsapp.number is not a valid international number (8-15 digits, no + or dashes) - the WhatsApp channel is hidden.",
	);
}

const labels = {
	toggleLabel: copy.contact.toggleLabel,
	copyAction: copy.contact.copyAction,
	copiedLabel: copy.contact.copiedLabel,
};
---

<section id="contact" class="section-pad">
	<div class="shell">
		<SectionHeading
			client:visible
			label={copy.contact.label}
			lines={copy.contact.lines}
			headingId="contact-heading"
		>
			<Reveal client:visible>
				<p class="mt-8 max-w-prose font-serif text-lead leading-[1.5] font-light text-ink-2">
					{copy.contact.body}
				</p>
			</Reveal>

			<ContactPanel client:load channels={contactChannels} labels={labels} />
		</SectionHeading>

		{/*
			The panel only exists once the island hydrates, so without JS the
			section would show a button that does nothing and no way to reach
			anyone. This hides the toggle and renders the channels themselves,
			expanded, inside the section so they stay in the landmark.

			`data-contact-toggle` is set by ContactPanel.tsx and must stay in
			sync with the selector below.
		*/}
		<noscript>
			<style>
				[data-contact-toggle] {
					display: none !important;
				}
			</style>
			<ul class="mt-10">
				{
					contactChannels.map((channel) => (
						<li class="border-t border-border/40 py-4 last:border-b">
							<a
								href={channel.href}
								target={channel.external ? "_blank" : undefined}
								rel={channel.external ? "noopener noreferrer" : undefined}
								class="block rounded-sm text-body text-ink underline-offset-4 hover:underline"
							>
								<span class="block text-label uppercase tracking-label text-ink-2">
									{channel.label}
								</span>
								<span class="mt-1 block tracking-tight">{channel.value}</span>
							</a>
						</li>
					))
				}
			</ul>
		</noscript>
	</div>
</section>
