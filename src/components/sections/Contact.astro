---
import SectionHeading from "../react/SectionHeading";
import Reveal from "../react/Reveal";
import Icon from "../ui/Icon.astro";
import { copy } from "../../data/content";
import { hasEmail, hasWhatsApp, profile } from "../../data/profile";

// A channel you meant to publish but have not filled in yet should fail the
// conversation, not vanish quietly.
if (!hasEmail) {
	console.warn(
		"[content] profile.email is empty - the Email channel is hidden. Set it in src/data/profile.ts.",
	);
}
if (!hasWhatsApp) {
	console.warn(
		"[content] profile.whatsapp.number is not a valid international number (8-15 digits, no + or dashes) - the WhatsApp channel is hidden.",
	);
}

const waMeUrl = `https://wa.me/${profile.whatsapp.number}${
	profile.whatsapp.message ? `?text=${encodeURIComponent(profile.whatsapp.message)}` : ""
}`;
---

<section id="contact" class="section-pad">
	<div class="shell">
		<SectionHeading
			client:visible
			label={copy.contact.label}
			lines={copy.contact.lines}
			headingId="contact-heading"
		>
			<Reveal client:visible>
				<p class="mt-8 max-w-prose font-serif text-lead leading-[1.5] font-light text-ink-2">
					{copy.contact.body}
				</p>
			</Reveal>

			<div class="action-pair mt-10">
				{hasEmail && (
					<a
						href={`mailto:${profile.email}`}
						class="action-link"
					>
						<Icon name="mail" class="action-link-icon" />
						<span class="action-link-label">Email</span>
						<span class="action-link-value">{profile.email}</span>
						<Icon name="arrow-up-right" class="action-link-arrow" />
					</a>
				)}

				{hasWhatsApp && (
					<a
						href={waMeUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="action-link"
					>
						<Icon name="message-circle" class="action-link-icon" />
						<span class="action-link-label">WhatsApp</span>
						<span class="action-link-value">{profile.whatsapp.display}</span>
						<Icon name="arrow-up-right" class="action-link-arrow" />
					</a>
				)}
			</div>

			<hr class="quiet-line" />

			<a
				href={profile.links.github}
				target="_blank"
				rel="noopener noreferrer"
				class="github-link"
			>
				GitHub
			</a>
		</SectionHeading>
	</div>
</section>