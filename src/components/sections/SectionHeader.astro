---
/**
 * Shared section chrome: the tiny tracked label plus the large light heading.
 * Hierarchy comes from size and opacity, never from colour.
 */
interface Props {
	label: string;
	heading: string;
	id?: string;
	/** Renders the heading as `h3` when nested under another heading. */
	level?: 2 | 3;
}

const { label, heading, id, level = 2 } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
---

<header class="max-w-2xl">
	<p class="text-label uppercase tracking-label text-ink-2">{label}</p>
	<Heading
		id={id}
		class="mt-4 font-serif text-h2 leading-[1.12] font-light text-balance text-ink scroll-mt-24"
	>
		{heading}
	</Heading>
</header>